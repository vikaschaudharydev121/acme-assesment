# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# Generate a secret with:  openssl rand -base64 48

# Required: HMAC key for session tokens (>= 32 characters).
APP_JWT_SECRET=

# Bootstrap accounts, created on first start only (>= 12 characters each).
# Leave a password blank to skip creating that account.
APP_MANAGER_USERNAME=hr.manager
APP_MANAGER_PASSWORD=
APP_VIEWER_USERNAME=hr.viewer
APP_VIEWER_PASSWORD=

# Load the 10,000 demo employees when the database is empty.
APP_SEED_ENABLED=true

# Set to false only when serving over plain HTTP on a non-localhost host (not recommended).
# APP_SECURITY_COOKIE_SECURE=true
