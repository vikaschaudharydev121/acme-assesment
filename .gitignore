# =============================================================================================
# ACME Salary Management — root .gitignore
# Sub-project ignores: frontend/.gitignore (Angular CLI defaults) also applies inside frontend/.
# =============================================================================================

# ---- Secrets & local configuration (never commit) -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
application-local.yml
application-local.properties
docker-compose.override.yml

# ---- Java / Maven ---------------------------------------------------------------------------
target/
*.class
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
# JVM crash / replay dumps
hs_err_pid*
replay_pid*
# JaCoCo raw execution data (HTML report lives in target/)
*.exec

# The built Angular bundle is copied into the backend at package time (scripts/build.sh, Dockerfile)
backend/src/main/resources/static/

# ---- Runtime data ---------------------------------------------------------------------------
data/
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# ---- Node / Angular -------------------------------------------------------------------------
node_modules/
dist/
out-tsc/
.angular/
coverage/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# ---- Test & tooling output ------------------------------------------------------------------
test-results/
playwright-report/
blob-report/
__screenshots__/
*.log
logs/

# ---- Demo recordings ------------------------------------------------------------------------
# The published demo lives in docs/demo/; ignore recorder scratch output and stray copies elsewhere.
docs/demo/.recording/
docs/demo/demo-failure.png
/*.webm
/*.mp4
/*.mov

# ---- IDEs & editors -------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/
.history/
.project
.classpath
.settings/
.factorypath
.apt_generated/
bin/
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
\#*\#
.\#*

# ---- Operating systems ----------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
.nfs*

# ---- Misc temporary files -------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
tmp/
